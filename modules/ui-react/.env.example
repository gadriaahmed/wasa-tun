# Wasabi React UI — environment variables

# Backend API base URL (required for production static hosting)
# Example: https://wasabi.example.com
VITE_API_URL=http://localhost:8080

# Authentication mode: basic (default) or sso
VITE_AUTHN_TYPE=basic

# SSO redirects (only when VITE_AUTHN_TYPE=sso)
# VITE_SSO_NO_AUTH_REDIRECT=https://sso.example.com/login
# VITE_SSO_LOGOUT_REDIRECT=https://sso.example.com/logout
